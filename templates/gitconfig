# ~/.gitconfig
# Generated by install.sh from templates/gitconfig.
# Replace {{NAME}} and {{EMAIL}} manually if you install without the installer.

[user]
	name = {{NAME}}
	email = {{EMAIL}}

[init]
	defaultBranch = main

[color]
	ui = auto

[push]
	default = simple

[merge]
	# diff3 works on all Git versions (zdiff3 requires Git >= 2.35).
	# The installer automatically upgrades to zdiff3 when supported.
	conflictstyle = diff3

[core]
	editor = vim
	excludesfile = ~/.gitignore_global