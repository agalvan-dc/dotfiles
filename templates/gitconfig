# ~/.gitconfig
# Generated by install.sh from templates/gitconfig.
# Replace {{NAME}} and {{EMAIL}} manually if you install without the installer.

[user]
	name = {{NAME}}
	email = {{EMAIL}}

[init]
	defaultBranch = main

[color]
	ui = auto

[push]
	default = simple

[merge]
	conflictstyle = zdiff3

[core]
	editor = vim
	excludesfile = ~/.gitignore_global